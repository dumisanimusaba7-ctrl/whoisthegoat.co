# ─── Required ──────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Used for canonical links, Open
# Graph images and share links.
NEXT_PUBLIC_SITE_URL=https://whoisthegoat.co

# Supabase project URL and secret key (Project Settings → API Keys).
# Use the secret key (sb_secret_…) or the legacy service_role key.
# Server-side only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# HMAC key for pseudonymising voter IDs and IP addresses before they reach the
# database. At least 32 characters; generate with `openssl rand -hex 32`.
# Keep it stable: changing it lets every browser vote again.
VOTE_HASH_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────
# Votes allowed per network (IPv4 address or IPv6 /64) per debate.
# VOTE_LIMIT_PER_MINUTE=10
# VOTE_LIMIT_PER_DAY=200

# A country's split is published once it reaches this many votes.
# MIN_COUNTRY_VOTES=10

# Contact address shown on the privacy page.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@whoisthegoat.co

# Google AdSense. Nothing ad-related renders until these are set.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
# NEXT_PUBLIC_ADSENSE_SLOT_EDITORIAL=

# Vercel BotID runs automatically on Vercel deployments. Set to 1 to turn it
# off everywhere (client and server) if it ever needs to be bypassed.
# NEXT_PUBLIC_BOTID_DISABLED=1

# Test mode, for trying the vote before launch: one browser can vote any number
# of times and every vote is counted. Every page shows a notice while it's on.
# Clear the test votes with supabase/reset_votes.sql. Never launch with it on.
# NEXT_PUBLIC_VOTE_TEST_MODE=1
